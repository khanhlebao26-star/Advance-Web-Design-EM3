<div class="col-sm-3">
    <div class="single-item">
        <% if (product.tag) { %>
            <div class="ribbon-wrapper">
                <div class="ribbon"><%= product.tag %></div>
            </div>
        <% } %>

        <div class="single-item-header">
            <% if (product.image) { %>
                <a href="#">
                    <img src="/dest/images/products/<%= product.image %>" alt="<%= product.name %>">
                </a>
            <% } %>
        </div>

        <div class="single-item-body">
            <p class="single-item-title"><%= product.name %></p>
            <p class="single-item-price">
                <% if (product.promotion_price && product.promotion_price < (product.unit_price || product.price)) { %>
                    <span class="flash-del">$<%= product.unit_price || product.price %></span>
                    <span class="flash-sale">$<%= product.promotion_price %></span>
                <% } else { %>
                    <span>$<%= product.unit_price || product.price %></span>
                <% } %>
            </p>
        </div>

        <div class="single-item-caption">
            <a class="add-to-cart pull-left" href="#" aria-label="Add <%= product.name %> to cart">
                <i class="fa fa-shopping-cart"></i>
            </a>
            <a class="beta-btn primary" href="#">Buy now <i class="fa fa-chevron-right"></i></a>
            <div class="clearfix"></div>
        </div>
    </div>
</div>